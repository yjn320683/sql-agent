<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yjn.sqlagent.mapper.SqlTaskDependencyMapper">
  <resultMap id="dependencyMap" type="com.yjn.sqlagent.model.entity.SqlTaskDependency"><id column="id" property="id"/><result column="task_id" property="taskId"/><result column="upstream_task_id" property="upstreamTaskId"/><result column="dependency_type" property="dependencyType"/><result column="created_by" property="createdBy"/><result column="create_time" property="createTime"/></resultMap>
  <select id="listByTask" resultMap="dependencyMap">SELECT id,task_id,upstream_task_id,dependency_type,created_by,create_time FROM sql_task_dependency WHERE task_id=#{taskId} ORDER BY id</select>
  <select id="listAll" resultMap="dependencyMap">SELECT id,task_id,upstream_task_id,dependency_type,created_by,create_time FROM sql_task_dependency ORDER BY task_id,id</select>
  <delete id="deleteByTask">DELETE FROM sql_task_dependency WHERE task_id=#{taskId}</delete>
  <select id="selectLatestExecutionStatus" resultType="string">SELECT status FROM sql_task_execution WHERE task_id=#{taskId} ORDER BY id DESC LIMIT 1</select>
</mapper>
